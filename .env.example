# =============================================================================
# Celebra Environment Variables
# Copy to .env and fill in values
# =============================================================================

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# Database
POSTGRES_DB=celebra
POSTGRES_USER=celebra
POSTGRES_PASSWORD=celebra_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-secret

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Email (development uses console backend)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# AI Assistant (optional - app works without it)
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_MODEL=gpt-4
# AI_MAX_REQUESTS_PER_USER_PER_DAY=50
# AI_REQUEST_TIMEOUT_SECONDS=30

# Redis (optional - only if using Celery)
# REDIS_URL=redis://localhost:6379/0
